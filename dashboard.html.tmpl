function renderVariDonut(fillId,pctId,statId,af,vp){
  const fill=document.getElementById(fillId),pctEl=document.getElementById(pctId),stat=document.getElementById(statId);
  if(af===0){
    fill.setAttribute('stroke-dasharray','0 100');
    pctEl.textContent='—';pctEl.classList.add('empty');
    stat.className='vari-block-stat empty';stat.innerHTML='<span class="vari-num">0</span> / 0';
    return;
  }
  const pct=vp/af*100;
  fill.setAttribute('stroke-dasharray',pct.toFixed(2)+' 100');
  pctEl.textContent=pct.toFixed(1)+'%';pctEl.classList.remove('empty');
  stat.className='vari-block-stat';stat.innerHTML='<span class="vari-num">'+vp+'</span> / '+af;
}
function uDVari(){
  if(!document.getElementById('dVMFill'))return;
  const v=(D.varipulse_adoption||{})[cH]||{mtd:{af:0,varipulse:0},ytd:{af:0,varipulse:0}};
  renderVariDonut('dVMFill','dVMPct','dVMStat',v.mtd.af,v.mtd.varipulse);
  renderVariDonut('dVYFill','dVYPct','dVYStat',v.ytd.af,v.ytd.varipulse);
  const phys=Object.entries(D.varipulse_adoption_phys||{})
    .map(([p,e])=>{const h=e[cH];if(!h)return null;return{p:p,af:h.ytd.af,vp:h.ytd.varipulse,pct:h.ytd.af>0?h.ytd.varipulse/h.ytd.af*100:0}})
    .filter(r=>r&&r.vp>=1)
    .sort((a,b)=>dVSort==='count'?(b.vp-a.vp||b.pct-a.pct):(b.pct-a.pct||b.vp-a.vp))
    .slice(0,5);
  const section=document.getElementById('dVPSection');
  section.style.display=phys.length>0?'block':'none';
  if(phys.length===0)return;
  document.getElementById('dVPList').innerHTML=phys.map((r,i)=>(
    '<div class="vari-row vari-row-link" data-phys="'+r.p+'">'
    +'<div class="vari-rank">'+(i<9?'0':'')+(i+1)+'</div>'
    +'<div class="vari-main"><div class="vari-top"><span class="vari-name" title="'+r.p+'">Dr. '+r.p.split(' ').slice(-1)[0]+'</span><span class="vari-meta"><span class="vari-rowstat"><span class="vari-num">'+r.vp+'</span> / '+r.af+'</span><span class="vari-pct">'+r.pct.toFixed(1)+'%</span></span></div><div class="vari-bar"><div class="vari-bar-fill" style="width:'+r.pct.toFixed(2)+'%"></div></div></div>'
    +'</div>'
  )).join('');
  document.getElementById('dVPList').onclick=function(e){var r=e.target.closest('[data-phys]');if(r&&r.dataset.phys)goPD(r.dataset.phys)};
}
function uPDVari(){
  if(!document.getElementById('pdVMFill'))return;
  const phys=(D.varipulse_adoption_phys||{})[cPD]||{};
  const key=pdHTab==='all'?'__all__':pdHTab;
  const v=phys[key]||{mtd:{af:0,varipulse:0},ytd:{af:0,varipulse:0}};
  renderVariDonut('pdVMFill','pdVMPct','pdVMStat',v.mtd.af,v.mtd.varipulse);
  renderVariDonut('pdVYFill','pdVYPct','pdVYStat',v.ytd.af,v.ytd.varipulse);
}
function renderRecent(rows,cols,extra){
  if(!rows.length)return '<tr><td colspan="'+cols+'" class="recent-empty">No recent cases</td></tr>';
  let h='',prevY=null;
  rows.forEach(r=>{
    if(prevY!==null&&r.year!==prevY)h+='<tr class="recent-year"><td colspan="'+cols+'">'+r.year+'</td></tr>';
    h+='<tr><td class="recent-date">'+r.date+'</td>'+extra(r)+'</tr>';
    prevY=r.year;
  });
  return h;
}
function rcMatch(r,type,tech){
  if(tech==='vp'&&!r.vp)return false;
  if(type==='all')return true;
  if(type==='Other'){const known=[].concat(...Object.values(TYPE_GROUPS));return !known.includes(r.type)}
  return TYPE_GROUPS[type].includes(r.type);
}
function setRCChip(filterId,v){document.querySelectorAll('#'+filterId+' .rc-chip').forEach(b=>b.classList.toggle('active',b.dataset.v===v))}
function filDRCT(v){dRCType=v;setRCChip('dRCTypeFilter',v);uDRecent()}
function filDRCV(v){dRCTech=v;setRCChip('dRCTechFilter',v);uDRecent()}
function filPDRCT(v){pdRCType=v;setRCChip('pdRCTypeFilter',v);uPDRecent()}
function filPDRCV(v){pdRCTech=v;setRCChip('pdRCTechFilter',v);uPDRecent()}
function uDRecent(){
  const all=(D.recent_cases_by_hospital&&D.recent_cases_by_hospital[cH])||[];
  const rows=all.filter(r=>rcMatch(r,dRCType,dRCTech)).slice(0,30);
  document.getElementById('dRCBody').innerHTML=renderRecent(rows,4,r=>'<td title="'+r.physician_dr+'">'+r.physician_dr+'</td><td title="'+r.type+'">'+r.type+'</td><td title="'+r.cas+'">'+r.cas+'</td>');
}
