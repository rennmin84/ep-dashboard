<script>
const D=JSON.parse(`{{JSON_DATA}}`);
const M=D.meta,MO=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const PC=['#A01528','#EB1700','#F04D5E','#F48091','#F8A8B5','#FAC4CC','#FCDDE2','#FEE8EC'];
const PHC=['#1B395C','#234D79','#2C6097','#3573B5','#4786C9','#659AD1','#83AEDA','#A1C2E3','#BFD5EC','#DDE9F5'];
const OTHERS_COLOR='#e8e5dc';
function palWithOthers(pal,n,hasOthers){const out=pal.slice(0,n);if(hasOthers)out[n-1]=OTHERS_COLOR;return out}
let cH=null,cPD=null,pdHTab='all';
let dRCType='all',dRCTech='all',pdRCType='all',pdRCTech='all';
const TYPE_GROUPS={AF:['AF','Con. AF'],VT:['PVC','VT'],SVT:['WPW','AVNRT']};
let sRL=true,sDL=true,sPDL=true;
let rVSort='rate',dVSort='rate';
function sRVS(s){if(rVSort===s)return;rVSort=s;document.querySelectorAll('#rVSort .vari-sort-btn').forEach(b=>b.classList.toggle('active',b.dataset.v===s));uRVari()}
function sDVS(s){if(dVSort===s)return;dVSort=s;document.querySelectorAll('#dVSort .vari-sort-btn').forEach(b=>b.classList.toggle('active',b.dataset.v===s));uDVari()}
let charts={};
let rI=false,dI=false,pdI=false;
const VER='v2.0';

function init(){
  const fd=MO[M.last_month-1]+' '+M.last_day+', '+M.last_year;
  const fdShort='Data thru '+MO[M.last_month-1]+' '+M.last_day;
  const sp=document.getElementById('splash');
  setTimeout(()=>{sp.style.opacity='0';setTimeout(()=>sp.style.display='none',500)},2900);
  const now=new Date(),d=new Date(M.last_date),diff=Math.floor((now-d)/864e5);
  const ago=diff===0?'TODAY':diff+' DAY'+(diff>1?'S':'')+' AGO';
  document.querySelectorAll('.date-display').forEach(e=>e.textContent=fdShort);
  document.querySelectorAll('.dtt').forEach(e=>e.textContent='Data through '+fd);
  document.querySelectorAll('.dap').forEach(e=>e.textContent=ago);
  document.querySelectorAll('.sticky-logo').forEach(e=>e.src=HLOGO);
  const foot='<div class="page-footer-inner"><div><img src="'+BWLOGO+'" style="width:140px;height:auto;opacity:.7"></div><div>© '+M.last_year+' Eric Wang<span class="ft-sep">·</span>LA Key Account Dashboard '+VER+'</div><div style="margin-top:4px">Confidential · Internal Use Only<span class="ft-sep">·</span>Source: Salesforce</div></div>';
  ['footerR','footerH','footerP'].forEach(id=>{const el=document.getElementById(id);if(el)el.innerHTML=foot});
  cH=D.hospital_ytd_ranking.length>0?D.hospital_ytd_ranking[0].hospital:M.hospitals[0];
  cPD=D.phys_all_ytd_ranking.length>0?D.phys_all_ytd_ranking[0].physician:null;
  initRegion();rI=true;
}

// === HELPERS ===
function tc(s){return s.split(' ').map(w=>w.charAt(0).toUpperCase()+w.slice(1).toLowerCase()).join(' ')}
const HLOGO='data:image/png;base64,{{HLOGO_B64}}';
const BWLOGO='data:image/png;base64,{{BW_LOGO_B64}}';
const HABBR={'RONALD REAGAN UCLA MEDICAL CENTER':'UCLA','PROVIDENCE SAINT JOHNS HEALTH CENTER':"Saint John's",'KECK HOSPITAL OF USC':'Keck','USC ARCADIA HOSPITAL':'Arcadia','CEDARS SINAI MEDICAL CENTER':'Cedars','SOUTH CALIFORNIA PERMANENTE MEDICAL GROUP':'Kaiser','WST LOS ANGL VA MED  CENTER':'West LA'};
function hAbbr(h){return HABBR[h]||tc(h).split(' ').slice(0,2).join(' ')}
function shortPhys(n){const w=n.split(' ');return w.length>2?w.slice(0,2).join(' '):n}
function foldN(data,keyField,n){if(data.length<=n)return{labels:data.map(d=>d[keyField]),values:data.map(d=>d.count),hasOthers:false,othersCount:0,othersTotal:0};const top=data.slice(0,n);const rest=data.slice(n);const oc=rest.reduce((s,d)=>s+d.count,0);return{labels:[...top.map(d=>d[keyField]),'Others ('+rest.length+')'],values:[...top.map(d=>d.count),oc],hasOthers:true,othersCount:rest.length,othersTotal:oc}}
function fold6(data,keyField){return foldN(data,keyField,6)}
function bd(c,l){if(l===0&&c>0)return'<div class="delta new">NEW</div>';if(l===0)return'';const d=c-l,p=Math.round((c-l)/l*100),s=d>=0?'+':'';return'<div class="delta '+(d>=0?'up':'down')+'">'+(d>=0?'↑':'↓')+' '+s+d+' &nbsp;('+s+p+'%)</div>'}
function ac(id,t){const el=document.getElementById(id);const s=performance.now();(function tick(n){const p=Math.min((n-s)/600,1);el.textContent=Math.round(t*(1-Math.pow(1-p,3))).toLocaleString();if(p<1)requestAnimationFrame(tick)})(performance.now())}
function lu(a,k,v,f,d){const r=a.find(x=>x[k]===v);return r?r[f]:d}
function luHP(a,h,p){const r=a.find(x=>x.hospital===h&&x.physician===p);return r?r.count:0}
function co(){return{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{display:false},ticks:{font:{size:10,family:'-apple-system'},color:'#8a8578'}},y:{grid:{color:'#f0ede3'},ticks:{font:{size:10},color:'#8a8578'},beginAtZero:true,grace:'20%',afterDataLimits:(a)=>{if(a.max<5)a.max=a.max+1.2}}},spanGaps:true,animation:{duration:800,easing:'easeOutQuart'}}}
function doo(){return{responsive:true,maintainAspectRatio:false,cutout:'62%',plugins:{legend:{position:'right',labels:{font:{size:10,family:'-apple-system'},color:'#5a574c',boxWidth:10,boxHeight:10,padding:6}}},animation:{animateRotate:true,duration:800}}}
function mkC(id,type,cfg){if(charts[id])charts[id].destroy();charts[id]=new Chart(document.getElementById(id),{type,...cfg});return charts[id]}
function gradFill(color){return function(ctx){const c=ctx.chart,area=c.chartArea;if(!area)return color+'00';const g=c.ctx.createLinearGradient(0,area.top,0,area.bottom);g.addColorStop(0,color+'40');g.addColorStop(1,color+'00');return g}}
function cyPts(color){const r=Array(12).fill(3),bc=Array(12).fill(color||'#EB1700'),bw=Array(12).fill(0);r[M.last_month-1]=4;bc[M.last_month-1]='#fff';bw[M.last_month-1]=1.5;return{pointRadius:r,pointBackgroundColor:bc,pointBorderColor:Array(12).fill(color||'#EB1700'),pointBorderWidth:bw}}
function extTT(ctx){var el=document.getElementById('cttp');if(!el){el=document.createElement('div');el.id='cttp';el.className='cttp';document.body.appendChild(el)}var t=ctx.tooltip;if(!t||t.opacity===0){el.style.opacity=0;return}var dp=t.dataPoints;if(!dp||!dp.length){el.style.opacity=0;return}var ty=ctx.chart.config.type,r=ctx.chart.canvas.getBoundingClientRect(),h='';if(ty==='doughnut'){var di=dp[0].dataIndex,ld=ctx.chart.data.labels,da=ctx.chart.data.datasets[0].data,nm=ld[di],v=da[di];if(v==null||v===0){el.style.opacity=0;return}var tot=da.reduce(function(s,x){return s+(x||0)},0),pc=tot>0?Math.round(v/tot*100):0;h='<div class="cttp-period">'+String(nm).toUpperCase()+'</div><div class="cttp-value">'+v+' case'+(v===1?'':'s')+'</div><div class="cttp-delta mute">'+pc+'% of total</div>'}else{var i=dp[0].dataIndex,ds=ctx.chart.data.datasets,mo=MO[i],yoy=ds.length<=2&&/^\d{4}$/.test(ds[0].label),yr=yoy?ds[0].label:(M&&M.last_year)||'';h='<div class="cttp-period">'+mo.toUpperCase()+(yr?(' '+yr):'')+'</div>';if(yoy){var cy=ds[0].data[i];if(cy==null){el.style.opacity=0;return}h+='<div class="cttp-value">'+cy+' case'+(cy===1?'':'s')+'</div>';if(ds.length>1){var ly=ds[1].data[i],lyL=ds[1].label;if(ly!=null&&ly>0){var p=Math.round((cy-ly)/ly*100),sg=p>0?'+':'',cl=p>0?'pos':(p<0?'neg':'');h+='<div class="cttp-delta '+cl+'">'+sg+p+'% vs '+mo+' '+lyL+'</div>'}}}else{var rows=ds.map(function(d){var vv=d.data[i];if(vv==null)return null;return '<div class="cttp-row"><span class="cttp-dot" style="background:'+(d.borderColor||'#1a1a1a')+'"></span><span class="cttp-rowL">'+d.label+'</span><span class="cttp-rowV">'+vv+'</span></div>'}).filter(Boolean);if(!rows.length){el.style.opacity=0;return}h+=rows.join('')}}el.innerHTML=h;el.style.opacity=1;el.style.left=(r.left+window.pageXOffset+t.caretX)+'px';el.style.top=(r.top+window.pageYOffset+t.caretY)+'px'}
function coTT(){var o=co();o.interaction={mode:'index',intersect:false};o.plugins.tooltip={enabled:false,external:extTT};return o}
function dooTT(){var o=doo();o.plugins.legend={display:false};o.plugins.tooltip={enabled:false,external:extTT};return o}

// === TAB SWITCHING ===
function sw(t){
  document.querySelectorAll('.page-region,.page-detail,.page-physician').forEach(e=>e.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(e=>e.classList.toggle('active',e.dataset.tab===t));
  document.querySelectorAll('.desktop-nav-item').forEach(e=>e.classList.toggle('active',e.dataset.tab===t));
  if(t==='region'){document.getElementById('pageRegion').classList.add('active')}
  if(t==='detail'){document.getElementById('pageDetail').classList.add('active');if(!dI){initDetail();dI=true}else updateDetail()}
  if(t==='physician'){document.getElementById('pagePhysician').classList.add('active');if(!pdI){initPhysDet();pdI=true}else updatePhysDet()}
  document.getElementById('scrollArea').scrollTop=0;
}

