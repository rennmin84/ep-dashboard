function gPF(h){return D.hospital_physician_ytd.filter(x=>x.hospital===h).sort((a,b)=>b.count-a.count)}
function uDPhysMix(){
  const all=gPF(cH);
  const total=all.reduce((s,x)=>s+x.count,0);
  const top=all.slice(0,10);
  const rest=all.slice(10);
