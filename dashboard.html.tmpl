  if(sRL)ds.push({label:String(ly),data:lyD,borderColor:'#b8b4a8',borderDash:[4,4],borderWidth:1.5,pointRadius:0,tension:.3});
  mkC('rLC','line',{data:{labels:MO,datasets:ds},options:coTT()});
}
function tRL(){sRL=!sRL;uRL()}
function rnPL(elId,data){
  const total=data.reduce((s,d)=>s+d.count,0);
  if(total===0){document.getElementById(elId).innerHTML='';return}
  const top=data.slice(0,6),rest=data.slice(6),othersCnt=rest.reduce((s,d)=>s+d.count,0);
  let rows=top.map((d,i)=>{
    const pct=Math.round(d.count/total*100);
    return'<div class="proc-row"><div class="proc-dot" style="background:'+PC[i]+'"></div><div class="proc-content"><span class="proc-name">'+d.procedure+'</span><span class="proc-count">'+d.count+'</span><span class="proc-pct">'+pct+'%</span></div></div>'
  }).join('');
  if(rest.length>0){const opct=Math.round(othersCnt/total*100);rows+='<div class="proc-row"><div class="proc-dot" style="background:'+OTHERS_COLOR+'"></div><div class="proc-content"><span class="proc-name" style="color:var(--text3)">Others ('+rest.length+' procedures)</span><span class="proc-count">'+othersCnt+'</span><span class="proc-pct">'+opct+'%</span></div></div>'}
  document.getElementById(elId).innerHTML=rows;
}
function buildRP(){
