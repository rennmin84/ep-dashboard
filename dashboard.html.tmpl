function uRL(){
  const cy=M.last_year,ly=cy-1,cyD=Array(12).fill(0),lyD=Array(12).fill(0);
  D.region_monthly.forEach(r=>{const[y,m]=r.ym.split('-').map(Number);if(y===cy)cyD[m-1]=r.count;if(y===ly)lyD[m-1]=r.count});
