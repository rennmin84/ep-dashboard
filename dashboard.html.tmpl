  el.onclick=function(e){var btn=e.target.closest('.hosp-tab');if(btn&&btn.dataset.ht){pdHTab=btn.dataset.ht==='all'?'all':btn.dataset.ht;updatePhysDet();el.querySelectorAll('.hosp-tab').forEach(t=>t.classList.toggle('active',t.dataset.ht===pdHTab))}};
}
function updatePhysDet(){
  const p=cPD,h=pdHTab;
  let mc,ml,yc,yl;
  if(h==='all'){
    mc=lu(D.phys_mtd_all,'physician',p,'count',0);ml=lu(D.phys_mtd_ly_full_all,'physician',p,'count',0);
    yc=lu(D.phys_ytd_all,'physician',p,'count',0);yl=lu(D.phys_ytd_ly_all,'physician',p,'count',0);
  }else{
    mc=luHP(D.phys_mtd_current,h,p);ml=luHP(D.phys_mtd_ly_full,h,p);
    yc=luHP(D.phys_ytd_current,h,p);yl=luHP(D.phys_ytd_ly,h,p);
  }
  ac('pdMV',mc);ac('pdYV',yc);
  document.getElementById('pdMP').textContent=MO[M.last_month-1]+' 1 – '+M.last_day;
  document.getElementById('pdYP').textContent='Jan 1 – '+MO[M.last_month-1]+' '+M.last_day;
  document.getElementById('pdMD').innerHTML=bd(mc,ml);document.getElementById('pdYD').innerHTML=bd(yc,yl);
  uPDHComp();uPDLine();uPDProc();uPDVari();uPDRecent();
  const multi=D.phys_hospitals.filter(x=>x.physician===cPD).length>1;
  const scope=multi?(pdHTab==='all'?'· All':'· '+hAbbr(pdHTab)):'';
  document.getElementById('pdPerfMeta').textContent=scope;
  document.getElementById('pdLMeta').textContent=scope;
  document.getElementById('pdPMeta').textContent=scope;
  const vMeta=document.getElementById('pdVMeta');if(vMeta)vMeta.textContent=scope;
}
function uPDRecent(){
  const phys=(D.recent_cases_by_physician||{})[cPD]||{};
  const all=(pdHTab==='all'?phys.__all__:phys[pdHTab])||[];
  const rows=all.filter(r=>rcMatch(r,pdRCType,pdRCTech)).slice(0,30);
  document.getElementById('pdRCBody').innerHTML=renderRecent(rows,4,r=>{const ha=hAbbr(r.hospital);return '<td title="'+r.hospital+'">'+ha+'</td><td title="'+r.type+'">'+r.type+'</td><td title="'+r.cas+'">'+r.cas+'</td>'});
}
function uPDHComp(){
  const p=cPD,cy=M.last_year;
  const hosps=D.phys_hospitals.filter(x=>x.physician===p);
  const section=document.getElementById('pdHCompSection');
  if(hosps.length<=1){section.style.display='none';return}
  section.style.display='block';
  const colors=['#EB1700','#5BA0D0','#2d7a4f','#b4aa82'];
  const ds=hosps.map((h,i)=>{
    const data=Array(12).fill(0);
    D.hospital_physician_monthly.filter(x=>x.hospital===h.hospital&&x.physician===p).forEach(r=>{const[yy,mm]=r.ym.split('-').map(Number);if(yy===cy)data[mm-1]=r.count});
    for(let j=M.last_month;j<12;j++)data[j]=null;
    return {label:hAbbr(h.hospital),data,borderColor:colors[i%colors.length],backgroundColor:colors[i%colors.length],borderWidth:2.5,pointRadius:3,pointBackgroundColor:colors[i%colors.length],tension:.3};
  });
  const total=hosps.reduce((s,h)=>s+h.count,0);
  document.getElementById('pdHCompS').textContent=cy+' · '+total+' YTD cases across '+hosps.length+' hospitals';
  document.getElementById('pdHCompLegend').innerHTML=hosps.map((h,i)=>'<div class="legend-item"><div class="legend-line" style="background:'+colors[i%colors.length]+'"></div><span>'+hAbbr(h.hospital)+'</span></div>').join('');
  mkC('pdHCompC','line',{data:{labels:MO,datasets:ds},options:coTT()});
}
function uPDLine(){
  const cy=M.last_year,ly=cy-1,p=cPD,h=pdHTab;
  let src;
  if(h==='all')src=D.phys_monthly_all.filter(x=>x.physician===p);
  else src=D.hospital_physician_monthly.filter(x=>x.hospital===h&&x.physician===p);
  const cyD=Array(12).fill(0),lyD=Array(12).fill(0);
  src.forEach(r=>{const[y,m]=r.ym.split('-').map(Number);if(y===cy)cyD[m-1]=r.count;if(y===ly)lyD[m-1]=r.count});
  for(let i=M.last_month;i<12;i++)cyD[i]=null;
  document.getElementById('pdLS').textContent=sPDL?cy+' vs '+ly:String(cy);
  const btn=document.getElementById('pdLT');
  btn.textContent='Show '+ly;
  btn.classList.toggle('off',!sPDL);
  const ds=[{label:String(cy),data:cyD,borderColor:'#EB1700',backgroundColor:gradFill('#EB1700'),fill:true,borderWidth:2.5,...cyPts(),tension:.3}];
  if(sPDL)ds.push({label:String(ly),data:lyD,borderColor:'#b8b4a8',borderDash:[4,4],borderWidth:1.5,pointRadius:0,tension:.3});
  mkC('pdLC','line',{data:{labels:MO,datasets:ds},options:coTT()});
}
function tPDL(){sPDL=!sPDL;uPDLine()}
function uPDProc(){
  const p=cPD,h=pdHTab;
  let data;
  if(h==='all')data=D.phys_procedure_ytd_all.filter(x=>x.physician===p).sort((a,b)=>b.count-a.count);
  else data=D.hospital_physician_procedure_ytd.filter(x=>x.hospital===h&&x.physician===p).sort((a,b)=>b.count-a.count);
  const total=data.reduce((s,d)=>s+d.count,0);
  document.getElementById('pdPS').textContent='YTD '+M.last_year+' · '+total+' cases'+(h!=='all'?' at '+hAbbr(h):'');
  rnPL('pdPL',data);
  const fd=fold6(data,'procedure');
  mkC('pdPC','doughnut',{data:{labels:fd.labels,datasets:[{data:fd.values,backgroundColor:palWithOthers(PC,fd.labels.length,fd.hasOthers),borderWidth:2,borderColor:'#fff'}]},options:dooTT()});
}

// === NAVIGATION ===
function goH(h){cH=h;sw('detail');selH(h)}
function goPD(p){cPD=p;pdHTab='all';sw('physician');selPD(p)}

init();
</script>
</body>
</html>